# Meu Bebê API — configuração via variáveis de ambiente.
# Copie para `.env` e ajuste conforme o ambiente.
APP_NAME=meu-bebe-api
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

# FASE 4B — artefato de ML (não copiado para api/; continua em ia/artifacts/models/).
# Caminhos relativos à raiz de api/ (resolvidos de forma independente do CWD).
MODEL_ARTIFACT_PATH=../ia/artifacts/models/selected_model_v1.joblib
MODEL_MANIFEST_PATH=../ia/artifacts/models/selected_model_v1_manifest.json
# true = carrega o modelo no startup (readiness); false = app sobe sem modelo.
MODEL_LOAD_ON_STARTUP=true

# FASE 8B — persistência (opcional). Deixe VAZIO para manter o subsistema
# persistente INERTE (sem engine, sem dependência de banco; o endpoint DSS
# permanece independente). Para ativar, preencha com a URL SQLAlchemy completa
# (dialeto postgresql+psycopg). NUNCA versionar senha real — use apenas o .env.
# Exemplo: DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/meu_bebe
DATABASE_URL=

# FASE 8B — banco DEDICADO de testes (integração com PostgreSQL real).
# Usado APENAS pela suíte de testes (tests/test_db_integration.py); NUNCA pelo
# app em runtime. Vazio = testes de integração pulados. NUNCA versionar senha.
# Exemplo: TEST_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/meu_bebe_test
TEST_DATABASE_URL=

# FASE 8C — autenticação (JWT). Deixe JWT_SECRET VAZIO para manter a auth
# INERTE (endpoints respondem 503 AUTH_NOT_CONFIGURED; DSS inalterado).
# Para ativar, gere um segredo de alta entropia (>= 32 bytes), por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA versionar o segredo real — use apenas o .env.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
